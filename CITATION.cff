    family-names: Dahlgren
  - given-names: Bernhard
    family-names: Schölkopf
  - given-names: "Terry Jingchen"
    family-names: Zhang
  - given-names: Zhijing
    family-names: Jin

# The paper is what people should actually cite; the block above describes this
# repository. When the conference version appears, change `type` to
# `conference-paper` and add `collection-title` / `conference` / `year`.
preferred-citation:
  type: article
  title: "GT-HarmBench: Benchmarking AI Safety Risks Through the Lens of Game Theory"
  year: 2026
  journal: "arXiv preprint arXiv:2602.12316"
  doi: 10.48550/arXiv.2602.12316
  url: "https://arxiv.org/abs/2602.12316"
