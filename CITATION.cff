cff-version: 1.2.0
message: "If you use GT-HarmBench, please cite the paper below."
title: "GT-HarmBench: Benchmarking AI Safety Risks Through the Lens of Game Theory"
type: dataset
license: CC-BY-4.0
url: "https://github.com/Flecart/gt-harmbench"
repository-code: "https://github.com/Flecart/gt-harmbench"
# Mirror; the canonical copy of the data ships in this repository under data/.
identifiers:
